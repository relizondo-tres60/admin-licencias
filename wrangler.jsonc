{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "admin-licencias",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-15",

  // Frontend estático (Cloudflare Assets). El Worker resuelve el fallback SPA.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },

  // Base de datos D1.
  // Reemplazar database_id con el valor real tras crearla:
  //   wrangler d1 create admin-licencias
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admin-licencias",
      "database_id": "REEMPLAZAR_TRAS_CREAR_D1",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "ENTORNO": "prod",
    "ADMIN_EMAIL": "rodrigo.a.elizondo@gmail.com",
    // Cloudflare Access (Zero Trust). Reemplazar los marcadores por los valores reales:
    //  - ACCESS_TEAM_DOMAIN: dominio del equipo (sin https://), p. ej. "miequipo.cloudflareaccess.com"
    //  - ACCESS_AUD: Application Audience (AUD) Tag de la app self-hosted creada sobre
    //                el hostname https://admin-licencias.relizondo-0d3.workers.dev
    // Mientras queden los marcadores (o vacíos), la API responde 401 en prod (seguro por defecto).
    "ACCESS_TEAM_DOMAIN": "PEGAR_TEAM_DOMAIN.cloudflareaccess.com",
    "ACCESS_AUD": "PEGAR_AUD_TAG"
  },

  "observability": {
    "enabled": true
  },

  // ── Entorno de desarrollo local (wrangler dev) ──────────────────────────────
  "env": {
    "dev": {
      "vars": {
        "ENTORNO": "dev",
        "ADMIN_EMAIL": "rodrigo.a.elizondo@gmail.com",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "admin-licencias",
          "database_id": "REEMPLAZAR_TRAS_CREAR_D1",
          "migrations_dir": "migrations"
        }
      ],
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS"
      }
    }
  }
}
